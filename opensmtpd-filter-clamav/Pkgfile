# Description: OpenSMTPD filter running messages through ClamAV
# URL: https://github.com/Lugaresi/filter-clamav
# Maintainer: Stuka
# Packager: Stuka
# Depends on: libevent libopensmtpd

name=opensmtpd-filter-clamav
version=0.1
release=1
source=()

build() {
	git clone https://github.com/Lugaresi/filter-clamav.git
	cd filter-clamav
	gcc -O2 main.c -o filter-clamav -lopensmtpd -levent
	strip filter-clamav
	install -m0755 -d $PKG/usr/lib/opensmtpd/
        install -m0755 filter-clamav $PKG/usr/lib/opensmtpd/
	install -m0755 -d $PKG/usr/man/man8/
	install -m0444 filter-clamav.8 $PKG/usr/man/man8
}
